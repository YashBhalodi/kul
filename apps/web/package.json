{
  "name": "kul-web",
  "version": "0.4.3",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite dev --port 3000",
    "typecheck": "tsr generate && tsc --noEmit && tsc --noEmit -p src/sw",
    "lint": "tsr generate && eslint --max-warnings 0 . && prettier --check . && node scripts/lint-colors.mjs",
    "format": "prettier --write .",
    "test": "vitest run",
    "build": "vite build && node scripts/build-sw.mjs && node scripts/finalize-dist.mjs && node scripts/check-dist.mjs && node scripts/check-links.mjs",
    "e2e": "playwright test --project=chromium --project=firefox --project=webkit",
    "shots": "playwright test --project=tour",
    "lighthouse": "lhci autorun --config=lighthouserc.json"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@codemirror/autocomplete": "6.20.4",
    "@codemirror/commands": "6.11.1",
    "@codemirror/language": "6.13.1",
    "@codemirror/lint": "6.9.7",
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@tanstack/pacer": "0.23.1",
    "@tanstack/react-hotkeys": "0.22.0",
    "@tanstack/react-router": "1.170.46",
    "@tanstack/react-start": "1.169.4",
    "@tanstack/react-store": "0.11.2",
    "class-variance-authority": "0.7.1",
    "cmdk": "1.1.1",
    "cn": "0.5.1",
    "comlink": "4.4.2",
    "fflate": "0.8.3",
    "fumadocs-core": "16.17.9",
    "fumadocs-mdx": "15.4.10",
    "fumadocs-ui": "npm:@fumadocs/base-ui@16.17.9",
    "kul-wasm": "*",
    "lucide-react": "1.66.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "shadcn": "4.23.0",
    "sonner": "2.0.8",
    "tw-animate-css": "1.4.0",
    "workbox-precaching": "7.4.1",
    "workbox-routing": "7.4.1",
    "workbox-window": "7.4.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@fontsource/inter": "5.3.0",
    "@lhci/cli": "0.15.1",
    "@playwright/test": "1.64.1",
    "@resvg/resvg-wasm": "2.6.2",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/react-router-devtools": "1.167.2",
    "@tanstack/router-cli": "1.167.46",
    "@types/hast": "3.0.5",
    "@types/mdx": "2.0.14",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/browser-playwright": "5.0.5",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "mdast-util-mdx-jsx": "3.2.0",
    "playwright": "1.64.1",
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vfile": "6.0.3",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "workbox-build": "7.4.1"
  }
}
